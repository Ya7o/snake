      "displayed_in_hud": true,
      "format": "X/quota (normal) or HP X/maxHp (boss)"
    },
    "this.runtimeScore": {
      "type": "display_score",
      "purpose": "Leaderboard/best score. Includes pickups + bonuses + clears.",
      "reset": "GameScene.create() → this.runtimeScore = 0",
      "displayed_in_hud": false,
      "displayed_at": ["ClearScene", "GameOverScene"]
    }
  },
